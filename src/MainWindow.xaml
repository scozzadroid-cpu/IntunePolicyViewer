<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6FA" UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="TextMain" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E5E9F0"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="Margin" Value="0,16,0,4"/>
    </Style>

    <Style x:Key="ReadOnlyText" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Voci di navigazione nella barra laterale -->
    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#AEB8CC"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="12,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="Nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="14,10">
              <Grid>
                <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,3,0,3" Background="#60A5FA" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center"/>
                  <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1E2638"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#26314A"/>
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Filtri a "pillola" per origine -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="Chips"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="15" Background="White" BorderBrush="#D9DEE7" BorderThickness="1" Padding="13,6">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#1E293B"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1E293B"/>
      <Setter Property="BorderBrush" Value="#D9DEE7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ic" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="BorderBrush" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="8">
              <Grid>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="34,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ph" Text="Cerca per nome, valore, area o origine…" Foreground="#9AA3B5" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Scrollbar sottili -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="t" Background="#CBD5E1" CornerRadius="4" Margin="2"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="t" Property="Background" Value="#94A3B8"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="#CBD5E1" CornerRadius="4" Margin="2"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Tabelle -->
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="RowHeight" Value="36"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="CanUserReorderColumns" Value="False"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#1E293B"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderBrush" Value="#E5E9F0"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal">
                  <ContentPresenter VerticalAlignment="Center"/>
                  <TextBlock x:Name="sort" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
              </Border>
              <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="SortDirection" Value="Ascending">
                <Setter TargetName="sort" Property="Text" Value="&#xE70E;"/>
                <Setter TargetName="sort" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="SortDirection" Value="Descending">
                <Setter TargetName="sort" Property="Text" Value="&#xE70D;"/>
                <Setter TargetName="sort" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="12,0" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F5F8FF"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E3ECFD"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CellTextStrong" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0F172A"/>
    </Style>
    <Style x:Key="CellTextMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="Foreground" Value="#475569"/>
    </Style>

    <!-- Badge origine della policy -->
    <DataTemplate x:Key="SourceBadge">
      <Border x:Name="b" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" Background="#E6EEFD" MaxWidth="200">
        <TextBlock x:Name="t" Text="{Binding SourceShort}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8" TextTrimming="CharacterEllipsis"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding SourceKind}" Value="GPO">
          <Setter TargetName="b" Property="Background" Value="#F3E8FF"/>
          <Setter TargetName="t" Property="Foreground" Value="#7E22CE"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SourceKind}" Value="REG">
          <Setter TargetName="b" Property="Background" Value="#EEF1F5"/>
          <Setter TargetName="t" Property="Foreground" Value="#475569"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SourceKind}" Value="WU">
          <Setter TargetName="b" Property="Background" Value="#DDF5EF"/>
          <Setter TargetName="t" Property="Foreground" Value="#0F766E"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ResultBadge">
      <Border x:Name="b" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" Background="#DCFCE7">
        <TextBlock x:Name="t" Text="{Binding Result}" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ResultKind}" Value="KO">
          <Setter TargetName="b" Property="Background" Value="#FEE2E2"/>
          <Setter TargetName="t" Property="Foreground" Value="#B91C1C"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding ResultKind}" Value="WARN">
          <Setter TargetName="b" Property="Background" Value="#FEF3C7"/>
          <Setter TargetName="t" Property="Foreground" Value="#B45309"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding ResultKind}" Value="INFO">
          <Setter TargetName="b" Property="Background" Value="#EEF1F5"/>
          <Setter TargetName="t" Property="Foreground" Value="#475569"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="InfoRowTemplate">
      <Grid Margin="0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="180"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#0F172A" TextWrapping="Wrap"/>
      </Grid>
    </DataTemplate>

    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#93B4F5"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Grid.Resources>

  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="236"/>
    <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- ===== Barra laterale ===== -->
  <Border Background="#121826">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,26,16,30">
        <Border Width="38" Height="38" CornerRadius="10">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#3B82F6" Offset="0"/>
              <GradientStop Color="#6366F1" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Policy Viewer" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="SideComputer" Text="" Foreground="#7D8AA5" FontSize="12"/>
        </StackPanel>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="24,0,20,22">
        <TextBlock x:Name="SideFooter" Foreground="#6B778F" FontSize="11.5" TextWrapping="Wrap" LineHeight="18"/>
      </StackPanel>

      <StackPanel>
        <TextBlock Text="PANORAMICA" Foreground="#56627A" FontSize="10.5" FontWeight="SemiBold" Margin="28,0,0,6"/>
        <RadioButton x:Name="NavSummary" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Riepilogo" IsChecked="True"/>
        <TextBlock Text="POLICY" Foreground="#56627A" FontSize="10.5" FontWeight="SemiBold" Margin="28,18,0,6"/>
        <RadioButton x:Name="NavUser" Style="{StaticResource NavButton}" Tag="&#xE77B;" Content="Utente"/>
        <RadioButton x:Name="NavMachine" Style="{StaticResource NavButton}" Tag="&#xE7F8;" Content="Macchina"/>
        <RadioButton x:Name="NavUpdates" Style="{StaticResource NavButton}" Tag="&#xE895;" Content="Aggiornamenti"/>
        <TextBlock Text="WINDOWS UPDATE" Foreground="#56627A" FontSize="10.5" FontWeight="SemiBold" Margin="28,18,0,6"/>
        <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="Cronologia"/>
      </StackPanel>
    </DockPanel>
  </Border>

  <!-- ===== Area principale ===== -->
  <Grid Grid.Column="1">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="32,26,32,18">
      <StackPanel>
        <TextBlock x:Name="PageTitle" Text="Riepilogo" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
        <TextBlock x:Name="PageSubtitle" Text="" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="BtnRefresh" Style="{StaticResource BaseButton}" Tag="&#xE72C;" Content="Aggiorna"/>
        <Button x:Name="BtnExport" Style="{StaticResource PrimaryButton}" Tag="&#xE74E;" Content="Esporta report"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="Toolbar" Grid.Row="1" Margin="32,0,32,16" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"/>
      <StackPanel x:Name="Chips" Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
        <RadioButton x:Name="ChipAll" Style="{StaticResource Chip}" Tag="" Content="Tutte" IsChecked="True"/>
        <RadioButton x:Name="ChipMdm" Style="{StaticResource Chip}" Tag="MDM" Content="Intune"/>
        <RadioButton x:Name="ChipGpo" Style="{StaticResource Chip}" Tag="GPO" Content="GPO"/>
        <RadioButton x:Name="ChipReg" Style="{StaticResource Chip}" Tag="REG" Content="Registro"/>
        <RadioButton x:Name="ChipWu" Style="{StaticResource Chip}" Tag="WU" Content="Windows Update"/>
      </StackPanel>
      <TextBlock x:Name="CountText" Grid.Column="2" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="12.5"/>
    </Grid>

    <!-- Pagina Riepilogo -->
    <ScrollViewer x:Name="PageSummary" Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32,0,32,28">
        <Border x:Name="WarningCard" Background="#FFF8EB" BorderBrush="#F6D58E" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
          <DockPanel>
            <Button x:Name="BtnElevate" DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Tag="&#xE7EF;" Content="Riavvia come amministratore" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#B45309" FontSize="16" Margin="0,2,12,0" VerticalAlignment="Top"/>
            <ItemsControl x:Name="WarningList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#7C4A03" TextWrapping="Wrap" Margin="0,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <Grid Margin="0,0,-16,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border x:Name="CardUser" Style="{StaticResource StatCard}">
            <StackPanel>
              <Border Width="36" Height="36" CornerRadius="18" Background="#E6EEFD" HorizontalAlignment="Left">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="StatUser" Text="–" FontSize="30" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,12,0,0"/>
              <TextBlock Text="Policy utente" Foreground="#334155" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatUserSub" Foreground="#64748B" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border x:Name="CardMachine" Grid.Column="1" Style="{StaticResource StatCard}">
            <StackPanel>
              <Border Width="36" Height="36" CornerRadius="18" Background="#EDE9FE" HorizontalAlignment="Left">
                <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" Foreground="#6D28D9" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="StatMachine" Text="–" FontSize="30" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,12,0,0"/>
              <TextBlock Text="Policy macchina" Foreground="#334155" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatMachineSub" Foreground="#64748B" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border x:Name="CardUpdates" Grid.Column="2" Style="{StaticResource StatCard}">
            <StackPanel>
              <Border Width="36" Height="36" CornerRadius="18" Background="#DDF5EF" HorizontalAlignment="Left">
                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="#0F766E" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="StatUpdates" Text="–" FontSize="30" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,12,0,0"/>
              <TextBlock Text="Policy aggiornamenti" Foreground="#334155" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatUpdatesSub" Foreground="#64748B" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border x:Name="CardHistory" Grid.Column="3" Style="{StaticResource StatCard}">
            <StackPanel>
              <Border Width="36" Height="36" CornerRadius="18" Background="#FEF3C7" HorizontalAlignment="Left">
                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="#B45309" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="StatHistory" Text="–" FontSize="30" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,12,0,0"/>
              <TextBlock Text="Aggiornamenti installati" Foreground="#334155" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatHistorySub" Foreground="#64748B" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Dispositivo" Style="{StaticResource CardTitle}"/>
              <ItemsControl x:Name="DeviceList" ItemTemplate="{StaticResource InfoRowTemplate}"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Gestione e sincronizzazione" Style="{StaticResource CardTitle}"/>
              <ItemsControl x:Name="MdmList" ItemTemplate="{StaticResource InfoRowTemplate}"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Criteri di gruppo (GPO)" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="GpoEmpty" Text="Nessun oggetto Criteri di gruppo rilevato." Foreground="#64748B" Visibility="Collapsed"/>
              <ItemsControl x:Name="GpoList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="ic" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#16A34A" FontSize="13" VerticalAlignment="Top" Margin="0,3,0,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Foreground="#0F172A" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Link}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Border Grid.Column="2" CornerRadius="10" Padding="9,3" Background="#EEF1F5" VerticalAlignment="Top" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Scope}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                      </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Applied}" Value="False">
                        <Setter TargetName="ic" Property="Text" Value="&#xE711;"/>
                        <Setter TargetName="ic" Property="Foreground" Value="#DC2626"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Windows Update in breve" Style="{StaticResource CardTitle}"/>
              <ItemsControl x:Name="UpdateSummaryList" ItemTemplate="{StaticResource InfoRowTemplate}"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- Pagina elenco policy (Utente / Macchina / Aggiornamenti) -->
    <Grid x:Name="PagePolicies" Grid.Row="2" Margin="32,0,32,28" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <ItemsControl x:Name="UpdateCards" Visibility="Collapsed" Margin="0,0,0,4">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="White" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,12,12" MinWidth="180" MaxWidth="360">
              <StackPanel>
                <TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="11.5"/>
                <TextBlock Text="{Binding Value}" Foreground="#0F172A" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
          <Grid>
            <DataGrid x:Name="PolicyGrid" Margin="1">
              <DataGrid.GroupStyle>
                <GroupStyle>
                  <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="GroupItem">
                            <Expander IsExpanded="True">
                              <Expander.Template>
                                <ControlTemplate TargetType="Expander">
                                  <DockPanel>
                                    <ToggleButton DockPanel.Dock="Top" Cursor="Hand" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                      <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                          <Border Background="#F3F6FB" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                              <TextBlock x:Name="chev" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Width="18"/>
                                              <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                          </Border>
                                          <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                              <Setter TargetName="chev" Property="Text" Value="&#xE76C;"/>
                                            </Trigger>
                                          </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                      </ToggleButton.Template>
                                      <ContentPresenter ContentSource="Header"/>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="body" Visibility="Collapsed"/>
                                  </DockPanel>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                      <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Expander.Template>
                              <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1E293B" FontSize="12.5"/>
                                  <Border CornerRadius="8" Background="#E2E8F0" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ItemCount}" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                  </Border>
                                </StackPanel>
                              </Expander.Header>
                              <ItemsPresenter/>
                            </Expander>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </GroupStyle.ContainerStyle>
                </GroupStyle>
              </DataGrid.GroupStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="NOME" Binding="{Binding Name}" Width="6*" MinWidth="200" ElementStyle="{StaticResource CellTextStrong}"/>
                <DataGridTextColumn Header="VALORE" Binding="{Binding Value}" Width="4*" MinWidth="140" ElementStyle="{StaticResource CellTextMuted}"/>
                <DataGridTemplateColumn Header="ORIGINE" Width="160" SortMemberPath="SourceShort">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SourceBadge}" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="GridEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
              <TextBlock Text="Nessuna policy corrisponde ai filtri" Foreground="#64748B" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
              <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
              <TextBlock Text="Seleziona una policy per vederne i dettagli" Foreground="#64748B" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel Margin="22,20,22,22">
                <TextBlock Text="DETTAGLIO POLICY" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding Name, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SourceBadge}" Margin="0,10,0,0" HorizontalAlignment="Left"/>

                <TextBlock Text="VALORE" Style="{StaticResource SectionLabel}"/>
                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,9">
                  <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Text="DESCRIZIONE" Style="{StaticResource SectionLabel}"/>
                <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding DescriptionText, Mode=OneWay}" Foreground="#334155"/>

                <TextBlock Text="AREA" Style="{StaticResource SectionLabel}"/>
                <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding Area, Mode=OneWay}"/>

                <TextBlock Text="ORIGINE" Style="{StaticResource SectionLabel}"/>
                <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding Source, Mode=OneWay}"/>

                <TextBlock Text="PERCORSO" Style="{StaticResource SectionLabel}"/>
                <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding Path, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Foreground="#334155"/>

                <TextBlock Text="DETTAGLI TECNICI" Style="{StaticResource SectionLabel}"/>
                <Border Background="#F8FAFC" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                  <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding Details, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Foreground="#334155"/>
                </Border>

                <Button x:Name="BtnCopy" Style="{StaticResource BaseButton}" Tag="&#xE8C8;" Content="Copia dettagli" HorizontalAlignment="Left" Margin="0,18,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Pagina cronologia Windows Update -->
    <Border x:Name="PageHistory" Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="32,0,32,28" ClipToBounds="True" Visibility="Collapsed">
      <DataGrid x:Name="HistoryGrid" Margin="1">
        <DataGrid.Columns>
          <DataGridTextColumn Header="DATA" Binding="{Binding DateText}" SortMemberPath="Date" Width="150" ElementStyle="{StaticResource CellTextMuted}"/>
          <DataGridTextColumn Header="AGGIORNAMENTO" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource CellTextStrong}"/>
          <DataGridTextColumn Header="OPERAZIONE" Binding="{Binding Operation}" Width="130" ElementStyle="{StaticResource CellTextMuted}"/>
          <DataGridTemplateColumn Header="ESITO" Width="170" SortMemberPath="Result">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResultBadge}" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>

  <!-- Caricamento -->
  <Grid x:Name="Overlay" Grid.Column="1" Background="#E6F4F6FA">
    <Border Background="White" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="14" Padding="34,26" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Width="300">
        <TextBlock Text="Raccolta delle policy in corso" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,12" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0"/>
        <TextBlock x:Name="OverlayText" Text="Avvio…" Foreground="#64748B" FontSize="12.5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
